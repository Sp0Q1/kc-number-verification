<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.keycloak</groupId>
  <artifactId>number-verification</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Keycloak Number Verification Required Action</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Reproducible builds: same sources + same toolchain => byte-identical JAR. -->
    <project.build.outputTimestamp>2026-10-01T00:00:00Z</project.build.outputTimestamp>
    <!-- Match this to the Keycloak version you deploy to. -->
    <keycloak.version>26.8.0</keycloak.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-core</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-services</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>4.5.14</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>number-verification</finalName>
    <plugins>
      <!--
                Every lifecycle plugin is pinned. Maven's built-in defaults differ
                between distributions (Debian's Maven 3.9.9 ships maven-jar-plugin
                3.1.2, which ignores outputTimestamp), so without pins the same
                commit produces different JARs on different machines. The Enforcer
                rule below fails the build if a pin goes missing.
            -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.2.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-site-plugin</artifactId>
        <version>3.22.0</version>
      </plugin>

      <!--
                Build hygiene: fails fast on the wrong toolchain or duplicate
                dependency declarations. Bound to 'validate', so it runs as part of
                every 'mvn package'.
            -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <!--
                    Rules live at plugin level (not inside the execution) so that both
                    the lifecycle-bound run and a direct 'mvn enforcer:enforce' see them.
                -->
        <configuration>
          <rules>
            <requireMavenVersion>
              <version>[3.6.3,)</version>
            </requireMavenVersion>
            <requireJavaVersion>
              <version>[17,)</version>
            </requireJavaVersion>
            <banDuplicatePomDependencyVersions/>
            <!-- Reproducible builds need every lifecycle plugin pinned. -->
            <requirePluginVersions/>
          </rules>
        </configuration>
        <executions>
          <execution>
            <id>enforce-build-hygiene</id>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
                Static analysis: SpotBugs with the Find Security Bugs rule set, at
                maximum effort and lowest threshold. Bound to 'verify' like Spotless,
                so 'mvn package' is never blocked; CI runs it in the Lint workflow.
                Suppressions live in spotbugs-exclude.xml.
            -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.10.4.1</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <failOnError>true</failOnError>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>1.14.0</version>
            </plugin>
          </plugins>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <!--
                Software bill of materials (CycloneDX JSON) next to the JAR. The
                provider bundles nothing, so the SBOM documents exactly that.
            -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>2.9.3</version>
        <configuration>
          <outputFormat>json</outputFormat>
          <outputName>sbom</outputName>
        </configuration>
        <executions>
          <execution>
            <id>sbom</id>
            <goals>
              <goal>makeAggregateBom</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>

      <!--
                Code formatting. The 'check' goal is bound to the 'verify' phase, so
                'mvn package' (how the JAR is built) is never blocked by formatting.
                CI runs 'mvn spotless:check' explicitly; run 'mvn spotless:apply'
                locally to auto-fix. AOSP style keeps the 4-space indentation used
                throughout this project.
            -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <java>
            <!--
                google-java-format 1.37.0 fails inside Spotless 3.10.x with an
                InvocationTargetException (it formats fine standalone). Stay on
                1.36.1 until a Spotless release supports 1.37.
            -->
            <googleJavaFormat>
              <version>1.36.1</version>
              <style>AOSP</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
            <removeUnusedImports/>
            <importOrder/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
